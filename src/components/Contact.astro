---
import { buildGoogleMapsEmbedUrl } from "../lib/shop-config";

const mapEmbedUrl = buildGoogleMapsEmbedUrl();

const contactDetails = {
	phone: "+44 20 7946 0958",
	email: "hello@example.com",
	location: "123 High Street, London",
	hours: [
		{ days: "Monday – Friday", time: "7:00 AM – 6:00 PM" },
		{ days: "Saturday", time: "8:00 AM – 7:00 PM" },
		{ days: "Sunday", time: "8:00 AM – 5:00 PM" },
	],
};

const enquiryTypes = [
	"General Enquiry",
	"Custom Cake",
	"Birthday Cake",
	"Wedding Cake",
	"Order Enquiry",
	"Other",
];

const inputClass =
	"mt-2 w-full h-[52px] px-4 bg-white border border-neutral-200 rounded-lg text-[15px] text-black placeholder:text-neutral-400 focus:outline-none focus:border-black focus:ring-1 focus:ring-black/20 transition-colors";
const labelClass = "block text-xs font-medium tracking-widest uppercase text-neutral-500";
---

<section id="contact" class="w-full bg-white scroll-mt-20 overflow-x-clip">
	<div class="max-w-[1280px] mx-auto w-full px-6 sm:px-10 lg:px-12 pt-32 md:pt-40 pb-12 md:pb-16">
		<!-- Heading -->
		<div class="text-center">
			<p class="text-xs font-semibold tracking-[0.25em] uppercase text-neutral-500">Contact</p>
			<h1 class="font-playfair text-4xl sm:text-5xl md:text-6xl text-black mt-4">
				We'd love to <span class="italic">hear from you.</span>
			</h1>
			<p class="mt-4 text-[15px] md:text-base leading-relaxed text-neutral-600 max-w-[560px] mx-auto">
				Custom cakes, birthday bakes and wedding orders — tell us what you're
				craving and we'll get back to you shortly.
			</p>
		</div>

		<!-- Wide form -->
		<form id="contact-form" class="mt-10 md:mt-12">
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-5 md:gap-6">
				<div>
					<label for="contact-first-name" class={labelClass}>First name</label>
					<input
						id="contact-first-name"
						name="firstName"
						type="text"
						autocomplete="given-name"
						required
						placeholder="Jane"
						class={inputClass}
					/>
				</div>
				<div>
					<label for="contact-last-name" class={labelClass}>Last name</label>
					<input
						id="contact-last-name"
						name="lastName"
						type="text"
						autocomplete="family-name"
						required
						placeholder="Smith"
						class={inputClass}
					/>
				</div>
				<div>
					<label for="contact-email" class={labelClass}>Email</label>
					<input
						id="contact-email"
						name="email"
						type="email"
						autocomplete="email"
						required
						placeholder="you@example.com"
						class={inputClass}
					/>
				</div>
				<div>
					<label for="contact-phone" class={labelClass}>Phone</label>
					<input
						id="contact-phone"
						name="phone"
						type="tel"
						autocomplete="tel"
						placeholder="+44 20 0000 0000"
						class={inputClass}
					/>
				</div>
				<div class="sm:col-span-2">
					<label for="contact-subject" class={labelClass}>Subject / Enquiry type</label>
					<select id="contact-subject" name="subject" class={inputClass}>
						{enquiryTypes.map((type) => (
							<option value={type}>{type}</option>
						))}
					</select>
				</div>
				<div class="sm:col-span-2">
					<label for="contact-message" class={labelClass}>Message</label>
					<textarea
						id="contact-message"
						name="message"
						rows="7"
						required
						placeholder="Tell us a little about your cake, date and servings..."
						class="mt-2 w-full min-h-[180px] px-4 py-4 bg-white border border-neutral-200 rounded-lg text-[15px] text-black resize-y placeholder:text-neutral-400 focus:outline-none focus:border-black focus:ring-1 focus:ring-black/20 transition-colors"
					></textarea>
				</div>
			</div>

			<div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-4">
				<button
					type="submit"
					class="w-full sm:w-auto px-10 py-3.5 bg-crave-night text-white text-sm font-medium rounded-lg transition-colors duration-300 hover:bg-neutral-800"
				>
					Send Message
				</button>
				<p id="contact-form-status" role="status" aria-live="polite" hidden class="text-sm text-neutral-600">
					This contact form is a frontend-only demo and is not connected to a backend — no message was sent.
				</p>
			</div>
		</form>
	</div>

	<!-- Full-bleed map: outside the centered container so it stretches edge to edge -->
	<div class="w-full">
		<iframe
			title="Twinkle Bakes location map"
			src={mapEmbedUrl}
			class="w-full h-[300px] sm:h-[350px] lg:h-[420px] border-0 block"
			loading="lazy"
			allowfullscreen
			referrerpolicy="no-referrer-when-downgrade"
		></iframe>
	</div>

	<div class="max-w-[1280px] mx-auto w-full px-6 sm:px-10 lg:px-12 pb-14 md:pb-20">
		<!-- Contact information -->
		<div class="mt-14 md:mt-16 pt-10 md:pt-12 border-t border-neutral-200">
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-0">
				<div class="lg:px-8 lg:first:pl-0 lg:last:pr-0 lg:border-l lg:border-neutral-200 lg:first:border-l-0">
					<p class="text-xs font-semibold tracking-[0.2em] uppercase text-neutral-500">Phone</p>
					<a href={`tel:${contactDetails.phone.replace(/[^+\d]/g, "")}`} class="mt-3 block text-[15px] text-black hover:underline">
						{contactDetails.phone}
					</a>
				</div>
				<div class="lg:px-8 lg:first:pl-0 lg:last:pr-0 lg:border-l lg:border-neutral-200 lg:first:border-l-0">
					<p class="text-xs font-semibold tracking-[0.2em] uppercase text-neutral-500">Email</p>
					<a href={`mailto:${contactDetails.email}`} class="mt-3 block text-[15px] text-black break-all hover:underline">
						{contactDetails.email}
					</a>
				</div>
				<div class="lg:px-8 lg:first:pl-0 lg:last:pr-0 lg:border-l lg:border-neutral-200 lg:first:border-l-0">
					<p class="text-xs font-semibold tracking-[0.2em] uppercase text-neutral-500">Location</p>
					<p class="mt-3 text-[15px] text-black">{contactDetails.location}</p>
				</div>
				<div class="lg:px-8 lg:first:pl-0 lg:last:pr-0 lg:border-l lg:border-neutral-200 lg:first:border-l-0">
					<p class="text-xs font-semibold tracking-[0.2em] uppercase text-neutral-500">Opening Hours</p>
					<ul class="mt-3 space-y-1.5">
						{contactDetails.hours.map((slot) => (
							<li class="text-sm text-black">
								<span class="text-neutral-500">{slot.days}: </span>
								<span>{slot.time}</span>
							</li>
						))}
					</ul>
				</div>
			</div>

			<!-- Follow us -->
			<div class="mt-10 pt-8 border-t border-neutral-200 flex flex-col sm:flex-row items-center justify-center gap-4">
				<p class="text-xs font-semibold tracking-[0.2em] uppercase text-neutral-500">Follow Us</p>
				<div class="flex items-center gap-3">
					<a
						href="#"
						aria-label="Instagram"
						class="w-10 h-10 rounded-full border border-neutral-200 flex items-center justify-center text-black transition-colors duration-300 hover:bg-black hover:text-white hover:border-black"
					>
						<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
					</a>
					<a
						href="#"
						aria-label="Facebook"
						class="w-10 h-10 rounded-full border border-neutral-200 flex items-center justify-center text-black transition-colors duration-300 hover:bg-black hover:text-white hover:border-black"
					>
						<svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.37 14.5 5 15.5 5H18V0h-3.808C10.59 0 9 1.581 9 4.75V8z"/></svg>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const contactForm = document.getElementById("contact-form");
	contactForm?.addEventListener("submit", (event) => {
		event.preventDefault();
		const status = document.getElementById("contact-form-status");
		if (status) {
			status.hidden = false;
		}
	});
</script>
