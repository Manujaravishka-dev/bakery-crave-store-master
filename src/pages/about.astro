---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About | Crave Bakery">
	<!-- About hero -->
	<section id="about-hero" class="about-hero relative min-h-[90vh] w-full flex items-center overflow-hidden bg-crave-pastel">
		<div class="about-bg-word" aria-hidden="true">CRAVE</div>

		<div class="about-shape about-shape-a" aria-hidden="true"></div>
		<div class="about-shape about-shape-b" aria-hidden="true"></div>

		<div class="relative z-10 w-[90%] max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-10 items-center py-28 md:py-32">
			<!-- Text -->
			<div class="text-center lg:text-left">
				<p class="about-label inline-flex items-center gap-2 justify-center lg:justify-start text-[11px] font-bold tracking-[0.2em] text-crave-night/70">
					<span class="w-[7px] h-[7px] rounded-full bg-crave-rosa" aria-hidden="true"></span>
					ABOUT CRAVE
				</p>

				<h1 class="about-title font-playfair text-[clamp(44px,6vw,84px)] leading-[1.02] font-medium tracking-[-0.04em] mt-6 text-crave-night">
					More than a bakery.
					<br />
					<span class="italic text-crave-rosa">It's an experience.</span>
				</h1>

				<p class="about-subtitle mt-6 text-[clamp(14px,1.4vw,17px)] leading-[1.7] text-crave-night/70 max-w-[480px] mx-auto lg:mx-0">
					Classic flavors, modern creativity, and handcrafted moments made to be remembered.
				</p>

				<div class="about-cta mt-9 flex flex-col sm:flex-row gap-3.5 items-center lg:justify-start justify-center">
					<a
						href="/menu"
						class="about-btn inline-flex items-center justify-center gap-3 px-6 py-3.5 rounded-full bg-crave-night text-crave-pastel text-[13px] font-semibold shadow-xl shadow-crave-night/10"
					>
						<span>Explore our Menu</span>
						<span class="w-7 h-7 rounded-full bg-crave-pastel/20 flex items-center justify-center" aria-hidden="true">→</span>
					</a>
					<a
						href="/contact"
						class="about-btn inline-flex items-center justify-center gap-3 px-6 py-3.5 rounded-full bg-crave-rosa text-crave-night text-[13px] font-semibold shadow-xl shadow-crave-night/10"
					>
						<span>Get in touch</span>
						<span class="w-7 h-7 rounded-full bg-crave-pastel/25 flex items-center justify-center" aria-hidden="true">→</span>
					</a>
				</div>
			</div>

			<!-- Bakery visual -->
			<div class="about-visual relative justify-self-center mt-4 lg:mt-0">
				<div class="about-card w-[280px] sm:w-[320px] p-[18px] rounded-[36px] bg-crave-pastel/40 backdrop-blur-[18px] border border-crave-night/10 shadow-[18px_24px_45px_rgba(0,0,0,0.1),inset_3px_3px_10px_rgba(255,255,255,0.8),inset_-3px_-3px_10px_rgba(0,0,0,0.05)] rotate-[-2deg]">
					<div class="flex justify-between items-center text-[10px] font-bold tracking-[0.16em] opacity-70 text-crave-night">
						<span>THE CRAVE</span>
						<span class="w-[7px] h-[7px] rounded-full bg-crave-rosa shadow-[0_0_0_5px_rgba(0,0,0,0.03)]" aria-hidden="true"></span>
					</div>

					<div class="about-cake relative my-6 flex items-center justify-center h-[230px]">
						<div class="about-cake-shadow absolute bottom-6 w-[170px] h-8 rounded-full bg-crave-night/15 blur-2xl" aria-hidden="true"></div>

						<div class="relative w-[170px] h-[130px] drop-shadow-[14px_18px_14px_rgba(0,0,0,0.15)]">
							<div class="absolute left-0 bottom-0 w-full h-12 rounded-t-[22px] rounded-b-[14px] bg-crave-night shadow-[inset_8px_6px_10px_rgba(255,255,255,0.1)]"></div>
							<div class="absolute left-0 bottom-11 w-full h-12 rounded-t-[22px] rounded-b-[14px] bg-crave-rosa shadow-[inset_8px_6px_10px_rgba(255,255,255,0.28)]"></div>
							<div class="absolute left-0 bottom-[88px] w-full h-11 rounded-t-[22px] rounded-b-[14px] bg-crave-pastel shadow-[inset_8px_6px_10px_rgba(255,255,255,0.7)]"></div>

							<!-- Cream -->
							<div class="absolute left-[24px] top-[6px] w-[44px] h-6 rounded-full bg-crave-pastel shadow-[3px_5px_8px_rgba(0,0,0,0.08)] z-[5]" aria-hidden="true"></div>
							<div class="absolute right-[26px] top-[14px] w-[44px] h-6 rounded-full bg-crave-pastel shadow-[3px_5px_8px_rgba(0,0,0,0.08)] z-[5]" aria-hidden="true"></div>

							<!-- Cherries -->
							<div class="absolute left-[70px] top-0 w-[15px] h-[15px] rounded-full bg-crave-rosa z-[7] shadow-[3px_4px_6px_rgba(0,0,0,0.15)]" aria-hidden="true"></div>
							<div class="absolute left-[116px] top-3 w-[15px] h-[15px] rounded-full bg-crave-rosa z-[7] shadow-[3px_4px_6px_rgba(0,0,0,0.15)]" aria-hidden="true"></div>
							<div class="absolute left-[42px] top-[26px] w-[15px] h-[15px] rounded-full bg-crave-rosa z-[7] shadow-[3px_4px_6px_rgba(0,0,0,0.15)]" aria-hidden="true"></div>
						</div>
					</div>

					<div class="flex justify-between items-end">
						<div>
							<small class="block text-[9px] tracking-[0.16em] opacity-50 mb-1 text-crave-night">BAKED FRESH</small>
							<strong class="text-[14px] font-semibold text-crave-night">Every single day.</strong>
						</div>
						<div class="w-[34px] h-[34px] rounded-full bg-crave-night text-crave-pastel flex items-center justify-center text-lg" aria-hidden="true">+</div>
					</div>
				</div>

				<div class="about-orbit about-orbit-a" aria-hidden="true"></div>
				<div class="about-orbit about-orbit-b" aria-hidden="true"></div>
			</div>
		</div>
	</section>

	<!-- Story -->
	<section id="about-story" class="w-full bg-crave-pastel overflow-hidden">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 py-20 md:py-28 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
			<div class="lg:col-span-5 about-story-head text-center lg:text-left">
				<p class="about-label inline-flex items-center gap-2 justify-center lg:justify-start text-[11px] font-bold tracking-[0.2em] text-crave-night/70">
					<span class="w-[7px] h-[7px] rounded-full bg-crave-rosa" aria-hidden="true"></span>
					OUR STORY
				</p>
				<h2 class="font-playfair text-[clamp(34px,4.5vw,58px)] leading-[1.05] font-medium tracking-[-0.03em] mt-6 text-crave-night">
					Made with passion.
					<br />
					Baked with <span class="italic text-crave-rosa">purpose.</span>
				</h2>
			</div>

			<div class="lg:col-span-7 space-y-6 text-[15px] md:text-base leading-[1.8] text-crave-night/70">
				<p class="about-story-reveal">
					At Crave, every day starts the same way — with flour, patience, and the quiet
					belief that dessert should be felt, not just eaten. We bake the classics
					everyone knows, then give them a fresh, modern twist.
				</p>
				<p class="about-story-reveal">
					Our craft is built on quality ingredients and handcrafted preparation.
					Nothing is rushed and nothing is cut short. Every layer is put together by
					hand, so every bite carries the care that went into making it.
				</p>
				<p class="about-story-reveal">
					From everyday pastries to celebration cakes, our goal is simple: to make the
					moments you share over something sweet last a little longer. That is why
					everything we make is made to be remembered.
				</p>
			</div>
		</div>
	</section>

	<!-- Values -->
	<section id="about-values" class="w-full bg-crave-pastel overflow-hidden">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 pt-4 pb-20 md:pb-28">
			<div class="about-values-head text-center mb-12">
				<p class="about-label inline-flex items-center gap-2 justify-center text-[11px] font-bold tracking-[0.2em] text-crave-night/70">
					<span class="w-[7px] h-[7px] rounded-full bg-crave-rosa" aria-hidden="true"></span>
					WHAT WE STAND FOR
				</p>
				<h2 class="font-playfair text-[clamp(34px,4.5vw,58px)] leading-[1.05] font-medium tracking-[-0.03em] mt-6 text-crave-night">
					Three promises we never break.
				</h2>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<article class="about-value-card rounded-[30px] bg-white p-8 border border-crave-night/10 shadow-[14px_18px_34px_rgba(0,0,0,0.07),inset_3px_3px_8px_rgba(255,255,255,0.9),inset_-3px_-3px_8px_rgba(0,0,0,0.03)] transition-all duration-300 ease-in-out hover:-translate-y-1.5 hover:shadow-[20px_26px_44px_rgba(0,0,0,0.1),inset_3px_3px_8px_rgba(255,255,255,0.9),inset_-3px_-3px_8px_rgba(0,0,0,0.03)]">
					<div class="w-12 h-12 rounded-full bg-crave-rosa/70 text-crave-night flex items-center justify-center font-playfair text-lg shadow-[inset_4px_4px_8px_rgba(255,255,255,0.5),4px_6px_12px_rgba(0,0,0,0.08)]">
						01
					</div>
					<h3 class="font-playfair text-2xl md:text-[26px] mt-6 font-medium text-crave-night">Crafted With Care</h3>
					<p class="mt-3 text-sm md:text-[15px] leading-[1.7] text-crave-night/70">
						Every creation is prepared with attention to detail and a love for the craft.
					</p>
				</article>

				<article class="about-value-card rounded-[30px] bg-white p-8 border border-crave-night/10 shadow-[14px_18px_34px_rgba(0,0,0,0.07),inset_3px_3px_8px_rgba(255,255,255,0.9),inset_-3px_-3px_8px_rgba(0,0,0,0.03)] transition-all duration-300 ease-in-out hover:-translate-y-1.5 hover:shadow-[20px_26px_44px_rgba(0,0,0,0.1),inset_3px_3px_8px_rgba(255,255,255,0.9),inset_-3px_-3px_8px_rgba(0,0,0,0.03)]">
					<div class="w-12 h-12 rounded-full bg-crave-rosa/70 text-crave-night flex items-center justify-center font-playfair text-lg shadow-[inset_4px_4px_8px_rgba(255,255,255,0.5),4px_6px_12px_rgba(0,0,0,0.08)]">
						02
					</div>
					<h3 class="font-playfair text-2xl md:text-[26px] mt-6 font-medium text-crave-night">Classic With A Twist</h3>
					<p class="mt-3 text-sm md:text-[15px] leading-[1.7] text-crave-night/70">
						Familiar flavors are reimagined with modern ideas and creative combinations.
					</p>
				</article>

				<article class="about-value-card rounded-[30px] bg-white p-8 border border-crave-night/10 shadow-[14px_18px_34px_rgba(0,0,0,0.07),inset_3px_3px_8px_rgba(255,255,255,0.9),inset_-3px_-3px_8px_rgba(0,0,0,0.03)] transition-all duration-300 ease-in-out hover:-translate-y-1.5 hover:shadow-[20px_26px_44px_rgba(0,0,0,0.1),inset_3px_3px_8px_rgba(255,255,255,0.9),inset_-3px_-3px_8px_rgba(0,0,0,0.03)]">
					<div class="w-12 h-12 rounded-full bg-crave-rosa/70 text-crave-night flex items-center justify-center font-playfair text-lg shadow-[inset_4px_4px_8px_rgba(255,255,255,0.5),4px_6px_12px_rgba(0,0,0,0.08)]">
						03
					</div>
					<h3 class="font-playfair text-2xl md:text-[26px] mt-6 font-medium text-crave-night">Made To Be Remembered</h3>
					<p class="mt-3 text-sm md:text-[15px] leading-[1.7] text-crave-night/70">
						Every cake, pastry, and experience is created to make moments feel special.
					</p>
				</article>
			</div>
		</div>
	</section>
</Layout>

<style>
	.about-hero {
		isolation: isolate;
	}

	.about-bg-word {
		position: absolute;
		left: 50%;
		bottom: 2%;
		transform: translateX(-50%);
		font-size: clamp(130px, 21vw, 340px);
		font-weight: 900;
		line-height: 0.7;
		color: var(--color-crave-rosa);
		opacity: 0.16;
		letter-spacing: -0.08em;
		white-space: nowrap;
		z-index: -2;
		pointer-events: none;
		will-change: transform;
	}

	.about-shape {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
		z-index: 1;
		will-change: transform;
	}

	.about-shape-a {
		width: 64px;
		height: 64px;
		left: 7%;
		top: 22%;
		background: var(--color-crave-rosa);
		opacity: 0.5;
		box-shadow: inset 12px 12px 20px rgba(255, 255, 255, 0.5), 12px 16px 26px rgba(0, 0, 0, 0.08);
	}

	.about-shape-b {
		width: 36px;
		height: 36px;
		right: 9%;
		bottom: 20%;
		background: var(--color-crave-night);
		opacity: 0.85;
		box-shadow: inset 4px 4px 8px rgba(255, 255, 255, 0.12), 8px 12px 18px rgba(0, 0, 0, 0.14);
	}

	.about-orbit {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
		z-index: 2;
		will-change: transform;
	}

	.about-orbit-a {
		width: 26px;
		height: 26px;
		top: -14px;
		right: 4%;
		background: var(--color-crave-rosa);
		opacity: 0.75;
		box-shadow: inset 4px 4px 8px rgba(255, 255, 255, 0.5), 6px 9px 14px rgba(0, 0, 0, 0.1);
	}

	.about-orbit-b {
		width: 42px;
		height: 42px;
		bottom: -18px;
		left: 2%;
		background: var(--color-crave-night);
		opacity: 0.75;
		box-shadow: inset 5px 5px 9px rgba(255, 255, 255, 0.12), 7px 11px 16px rgba(0, 0, 0, 0.16);
	}

	@media (max-width: 700px) {
		.about-bg-word {
			font-size: 34vw;
			bottom: 10%;
		}

		.about-card {
			width: 250px;
		}

		.about-cake {
			height: 200px;
		}
	}
</style>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const page = document.getElementById("about-hero");

	if (page && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const ctx = gsap.context(() => {
			const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

			tl.fromTo(
				".about-label",
				{ y: -18, opacity: 0 },
				{ y: 0, opacity: 1, duration: 0.7 }
			)
				.from(
					".about-title",
					{
						opacity: 0,
						filter: "blur(6px)",
						scale: 0.98,
						duration: 1.1,
					},
					"-=0.35"
				)
				.from(
					".about-subtitle",
					{
						y: 22,
						opacity: 0,
						duration: 0.8,
					},
					"-=0.6"
				)
				.from(
					".about-cta",
					{
						y: 22,
						opacity: 0,
						scale: 0.96,
						duration: 0.7,
					},
					"-=0.5"
				)
				.from(
					".about-visual",
					{
						x: 60,
						opacity: 0,
						rotation: 4,
						scale: 0.9,
						duration: 1.1,
						ease: "back.out(1.3)",
					},
					"-=0.9"
				)
				.to(".about-card", {
					y: -12,
					duration: 3,
					repeat: -1,
					yoyo: true,
					ease: "sine.inOut",
				});

			gsap.to(".about-orbit-a", {
				y: -14,
				x: 10,
				rotation: 16,
				duration: 4.2,
				repeat: -1,
				yoyo: true,
				ease: "sine.inOut",
			});

			gsap.to(".about-orbit-b", {
				y: 12,
				x: -8,
				rotation: -18,
				duration: 3.6,
				repeat: -1,
				yoyo: true,
				ease: "sine.inOut",
			});

			gsap.to(".about-shape-a", {
				y: -20,
				rotation: 18,
				duration: 5,
				repeat: -1,
				yoyo: true,
				ease: "sine.inOut",
			});

			gsap.to(".about-shape-b", {
				y: 14,
				x: -8,
				rotation: -14,
				duration: 4.4,
				repeat: -1,
				yoyo: true,
				ease: "sine.inOut",
			});

			gsap.to(".about-bg-word", {
				y: -140,
				scale: 1.06,
				ease: "none",
				scrollTrigger: {
					trigger: "#about-hero",
					start: "top top",
					end: "bottom top",
					scrub: 1,
				},
			});

			gsap.to(".about-title", {
				y: -40,
				ease: "none",
				scrollTrigger: {
					trigger: "#about-hero",
					start: "top top",
					end: "bottom top",
					scrub: 1.2,
				},
			});

			gsap.to(".about-visual", {
				y: -120,
				ease: "none",
				scrollTrigger: {
					trigger: "#about-hero",
					start: "top top",
					end: "bottom top",
					scrub: 1,
				},
			});

			gsap.from(".about-story-head", {
				y: 40,
				opacity: 0,
				scrollTrigger: {
					trigger: "#about-story",
					start: "top 75%",
				},
			});

			gsap.from(".about-story-reveal", {
				y: 26,
				opacity: 0,
				stagger: 0.15,
				scrollTrigger: {
					trigger: "#about-story",
					start: "top 75%",
				},
			});

			gsap.from(".about-values-head", {
				y: 30,
				opacity: 0,
				scrollTrigger: {
					trigger: "#about-values",
					start: "top 78%",
				},
			});

			gsap.from(".about-value-card", {
				y: 50,
				opacity: 0,
				stagger: 0.14,
				scrollTrigger: {
					trigger: "#about-values",
					start: "top 75%",
				},
			});

			document.querySelectorAll(".about-btn").forEach((button) => {
				const press = () => {
					gsap.to(button, { scale: 0.95, duration: 0.12 });
				};

				const release = () => {
					gsap.to(button, { scale: 1, duration: 0.35, ease: "back.out(2)" });
				};

				button.addEventListener("mousedown", press);
				button.addEventListener("mouseup", release);
				button.addEventListener("mouseleave", release);
			});
		}, page);

		window.addEventListener("astro:before-swap", () => ctx.revert());
	}
</script>