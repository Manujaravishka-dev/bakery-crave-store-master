---
import Layout from "../layouts/Layout.astro";
import Gallery from "../components/Gallery";
---

<Layout title="Gallery | Twinkle Bakes">
	<section class="w-full bg-crave-pastel">
		<div class="max-w-6xl mx-auto w-full px-4 sm:px-6 pt-32 md:pt-40 pb-10 md:pb-12 text-center">
			<p class="inline-flex items-center gap-2 justify-center text-[11px] font-bold tracking-[0.2em] text-crave-night/70">
				<span class="w-[7px] h-[7px] rounded-full bg-crave-rosa" aria-hidden="true"></span>
				OUR CREATIONS
			</p>
			<h1 class="font-playfair text-[clamp(38px,5vw,68px)] leading-[1.05] font-medium tracking-[-0.03em] mt-5 text-crave-night">
				A little sweetness,<br />
				<span class="italic text-crave-rosa">captured.</span>
			</h1>
			<p class="mt-5 text-[15px] md:text-base leading-[1.7] text-crave-night/70 max-w-[520px] mx-auto">
				Explore some of our favourite cakes, bakes and celebrations created with care.
			</p>
		</div>

		<div class="max-w-6xl mx-auto w-full px-4 sm:px-6 pb-16 md:pb-24">
			<Gallery client:load />
		</div>

		<!-- CTA -->
		<div class="max-w-6xl mx-auto w-full px-4 sm:px-6 pb-20 md:pb-28 text-center">
			<h2 class="font-playfair text-[clamp(28px,3.5vw,44px)] leading-tight font-medium tracking-[-0.02em] text-crave-night">
				Have something special <span class="italic text-crave-rosa">in mind?</span>
			</h2>
			<p class="mt-4 text-[15px] md:text-base text-crave-night/70">
				Let's create something sweet for your celebration.
			</p>
			<a
				href="/contact"
				class="mt-8 inline-flex items-center justify-center gap-3 px-6 py-3.5 rounded-full bg-crave-night text-crave-pastel text-[13px] font-semibold shadow-xl shadow-crave-night/10 transition-transform duration-300 hover:-translate-y-0.5"
			>
				<span>Contact Us</span>
				<span class="w-7 h-7 rounded-full bg-crave-pastel/20 flex items-center justify-center" aria-hidden="true">→</span>
			</a>
		</div>
	</section>
</Layout>
